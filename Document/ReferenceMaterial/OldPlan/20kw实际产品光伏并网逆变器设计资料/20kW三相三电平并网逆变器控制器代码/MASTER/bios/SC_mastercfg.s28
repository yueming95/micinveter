;;
;; MEM_Obj M1SARAM (len, iAllocHeap, iSegZero, iHeapId)
	.global M1SARAM
	.asg 0400H, _len
	.asg 00H, _iAllocHeap
	.asg L4567SARAM, _iSegZero
	.asg segment_name, _iHeapId
	MEM_Obj 1, M1SARAM, 0, _len, _iAllocHeap, _iSegZero, _iHeapId

;; ======== MEM_Obj PASSWORDS ========
;; CSM Passwords in Flash
;;
;; MEM_Obj PASSWORDS (len, iAllocHeap, iSegZero, iHeapId)
	.global PASSWORDS
	.asg 08H, _len
	.asg 00H, _iAllocHeap
	.asg L4567SARAM, _iSegZero
	.asg segment_name, _iHeapId
	MEM_Obj 1, PASSWORDS, 0, _len, _iAllocHeap, _iSegZero, _iHeapId

;; ======== MEM_Obj FPUTABLES ========
;; FPU math table in Boot ROM
;;
;; MEM_Obj FPUTABLES (len, iAllocHeap, iSegZero, iHeapId)
	.global FPUTABLES
	.asg 06a0H, _len
	.asg 00H, _iAllocHeap
	.asg L4567SARAM, _iSegZero
	.asg segment_name, _iHeapId
	MEM_Obj 1, FPUTABLES, 0, _len, _iAllocHeap, _iSegZero, _iHeapId

;; ======== MEM_Obj IQTABLES ========
;; IQmath table 1 in Boot ROM
;;
;; MEM_Obj IQTABLES (len, iAllocHeap, iSegZero, iHeapId)
	.global IQTABLES
	.asg 0b50H, _len
	.asg 00H, _iAllocHeap
	.asg L4567SARAM, _iSegZero
	.asg segment_name, _iHeapId
	MEM_Obj 1, IQTABLES, 0, _len, _iAllocHeap, _iSegZero, _iHeapId

;; ======== MEM_Obj IQTABLES2 ========
;; IQmath table 2 in Boot ROM
